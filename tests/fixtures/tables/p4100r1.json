    [
     "Problem",
     "Why C++-specific",
     "Coroutine resolution"
    ],
    [
     "Template explosion",
     "Go has no templates",
     "coroutine_handle<> type erasure eliminates template metaprogramming"
    ],
    [
     "Compile times",
     "Rust does not have this problem at C++ scale",
     "any_stream compiles once and ships as a binary"
    ],
    [
     "Allocation control",
     "Python has no user-facing allocator model",
     "Frame allocator propagation gives users control where it matters"
    ],
    [
     "ABI stability",
     "The committee's twenty-year wound",
     "any_stream's ABI is a vtable - the same contract since 1983"
    ]
   ],
