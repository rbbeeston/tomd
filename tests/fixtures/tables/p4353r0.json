   "rows": [
    [
     "Nesting",
     "Innermost x",
     "Why"
    ],
    [
     "[const& x]{ x; }",
     "const lvalue",
     "the const-reference view"
    ],
    [
     "[const& x]{ [&x]{ x; } }",
     "const lvalue",
     "the view stays const through nesting"
    ],
    [
     "[const& x]{ [x]{ x; } }",
     "const copy",
     "a copy of a const view is const"
    ],
    [
     "[const& x]{ [x]() mutable { x = 0; } }",
     "ill-formed",
     "the const copy cannot be made mutable"
    ],
    [
     "[const& x]{ [&x]{ [x]() mutable {} } }",
     "const copy",
     "const carries through the plain-& middle"
    ],
    [
     "[&x]{ [x]() mutable { x = 0; } }",
     "OK",
     "no const& anywhere; an ordinary modifiable copy"
    ]
   ],
