  {
   "id": "p4353r0-t13",
   "pages": [
    7,
    8
   ],
   "rows": [
    [
     "Before",
     "After"
    ],
    [
     "struct A { State state; mutable Buffer buf; void operator()() const { // ... } }; // manual bespoke type move_only_function<void() const> f = A{s, b};",
     "move_only_function<void() const> f = [s, mutable b] { /* ... */ };"
    ],
    [
     "template <typename T> class as_owned_mutable { mutable T value; public: T& ref() const { return value; } }; // new vocabulary type move_only_function<void() const> f = [s, b = as_owned_mutable<Buffer>{}]() { auto& buffer = b.ref(); // ... };",
     "move_only_function<void() const> f = [s, mutable b] { // ... };"
    ],
    [
     "// loss of const correctness move_only_function<void()> f = [s, b]() mutable { // ... };",
     "move_only_function<void() const> f = [s, mutable b] { // ... };"
    ],
    [
     "// loss of ownership move_only_function<void() const> f = [s, buf_ptr = &b]() { // ... };",
     "move_only_function<void() const> f = [s, mutable b] { // ... };"
    ]
   ],
   "group": "g13",
   "source": "picked:tags13",
   "note": "cross-page; header only on first page",
   "scope": "table"
  },
  {
   "id": "p4353r0-t14",
   "pages": [
    9
   ],
   "rows": [
    [
     "Before",
     "After"
    ],
    [
     "template <typename T> class as_owned_const { T value; public: const T& ref() const { return value; } }; // new vocabulary type move_only_function<void()> f = [s, b = as_owned_const<Buffer>{}] mutable { auto& buffer = b.ref(); // ... };",
     "move_only_function<void()> f = [s, const b] mutable { // ... };"
    ],
    [
     "// loss of const correctness move_only_function<void()> f = [s, b]() mutable { // b can be mutated };",
     "move_only_function<void()> f = [s, const b] mutable { // ... };"
    ],
    [
     "// loss of ownership move_only_function<void()> f = [s, b = std::cref(buf)]() mutable { // ... };",
     "move_only_function<void()> f = [s, const b] mutable { // ... };"
    ]
   ],
